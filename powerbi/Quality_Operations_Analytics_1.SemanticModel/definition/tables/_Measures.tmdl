		formatString: 0
		lineageTag: 2a4a3393-7445-44b3-8934-c6c7ad4259fa

	measure 'Parking Defects' =
			
			SUM(Fact_QualityAudits[ParkingDefects])
		formatString: 0
		lineageTag: 158eb602-fe47-46a4-80a2-63ae17a31f8a

	measure 'Total Defects' =
			
			SUM(Fact_QualityAudits[TotalDefects])
		formatString: 0
		lineageTag: 92daa493-6c40-4041-93f4-5cf218242bb9

	measure DPV =
			
			DIVIDE(
			    [Total Defects],
			    [Vehicles Audited],
			    0
			)
		lineageTag: 7db9c79f-e3ad-4936-af13-7909065cbf25

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ADR =
			
			DIVIDE(
			    [Accessory Defects],
			    [Accessories Audited],
			    0
			) * 100
		lineageTag: 01921b00-bdfc-4abf-bbf7-da3fac02fd1f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DPV Target' = 0.14
		formatString: #,0.00
		lineageTag: ca11f7a7-de46-41cb-888f-422b7f755d6c

	measure 'ADR Target' = 3.50
		lineageTag: b75531a3-5d96-4bd8-88b0-c78bcc215576

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DPV Variance' =
			
			[DPV] - [DPV Target]
		lineageTag: bc041557-4fc2-4f2f-9b5a-67e6c28db720

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ADR Variance' =
			
			[ADR] - [ADR Target]
		lineageTag: 4c15a737-6a83-4d23-a236-b8f8bd54c87e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DPV Yellow Tolerance' =
			
			CALCULATE(
			    MAX(Fact_OperationalTargets[YellowTolerancePct]),
			    Fact_OperationalTargets[MetricName] = "DPV",
			    Fact_OperationalTargets[TargetLevel] = "Process",
			    REMOVEFILTERS(Dim_Auditor)
			)
		lineageTag: 3135893e-a7e3-4374-8de8-95d014e2e297

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DPV Red Tolerance' =
			
			CALCULATE(
			    MAX(Fact_OperationalTargets[RedTolerancePct]),
			    Fact_OperationalTargets[MetricName] = "DPV",
			    Fact_OperationalTargets[TargetLevel] = "Process",
			    REMOVEFILTERS(Dim_Auditor)
			)
		lineageTag: 3a7aad1c-51ad-41ca-8183-36048ca122f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DPV Status' =
			
			VAR ActualValue = [DPV]
			VAR TargetValue = [DPV Target]
			VAR YellowLimit =
			    TargetValue * (1 + [DPV Yellow Tolerance])
			VAR RedLimit =
			    TargetValue * (1 + [DPV Red Tolerance])
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(ActualValue) || ISBLANK(TargetValue), BLANK(),
			        ActualValue <= TargetValue, "GREEN",
			        ActualValue <= YellowLimit, "YELLOW",
			        ActualValue <= RedLimit, "RED",
			        "RED"
			    )
		lineageTag: 8d2bec0c-a53f-4c33-b048-d0d7e1653409

	measure 'ADR Yellow Tolerance' =
			
			CALCULATE(
			    MAX(Fact_OperationalTargets[YellowTolerancePct]),
			    Fact_OperationalTargets[MetricName] = "ADR",
			    Fact_OperationalTargets[TargetLevel] = "Process",
			    REMOVEFILTERS(Dim_Auditor)
			)
		lineageTag: 4e229d5f-3923-41a0-be09-ebd2e28fe1e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ADR Red Tolerance' =
			
			CALCULATE(
			    MAX(Fact_OperationalTargets[RedTolerancePct]),
			    Fact_OperationalTargets[MetricName] = "ADR",
			    Fact_OperationalTargets[TargetLevel] = "Process",
			    REMOVEFILTERS(Dim_Auditor)
			)
		lineageTag: 5f3c081a-653d-48f0-ab6e-7df322d9df14

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ADR Status' =
			
			VAR ActualValue = [ADR]
			VAR TargetValue = [ADR Target]
			VAR YellowLimit =
			    TargetValue * (1 + [ADR Yellow Tolerance])
			VAR RedLimit =
			    TargetValue * (1 + [ADR Red Tolerance])
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(ActualValue) || ISBLANK(TargetValue), BLANK(),
			        ActualValue <= TargetValue, "GREEN",
			        ActualValue <= YellowLimit, "YELLOW",
			        ActualValue <= RedLimit, "RED",
			        "RED"
			    )
		lineageTag: 3f0bf428-5054-45f1-8e50-1028c51aa147

	measure 'Completed Audits' =
			
			SUM(Fact_OperationalAudits[CompletedAudits])
		formatString: 0
		lineageTag: 7a0dade7-0738-4932-8f88-59d17a1853a2

	measure 'Load Line Actual' =
			
			CALCULATE(
			    [Completed Audits],
			    Dim_Process[ProcessName] = "Load Line"
			)
		formatString: 0
		lineageTag: 5b6ab00c-f3a8-460e-8495-a5ca4f84c4e0

	measure 'Outbound Actual' =
			
			CALCULATE(
