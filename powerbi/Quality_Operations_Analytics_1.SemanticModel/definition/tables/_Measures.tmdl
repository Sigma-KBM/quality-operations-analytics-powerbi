table _Measures
	lineageTag: 8d350f9a-46e5-48a7-b4ae-5587d8da1fbe

	measure 'Vehicles Audited' =
			
			DISTINCTCOUNT(Fact_QualityAudits[VehicleID])
		formatString: 0
		lineageTag: 8b389eb5-e48d-4744-9fa1-14f9d595dc19

	measure 'Accessories Audited' =
			
			SUM(Fact_QualityAudits[AccessoriesAudited])
		formatString: 0
		lineageTag: b9ac1784-8f9e-4467-9fe4-4e76ed7ed673

	measure 'Accessory Defects' =
			
			SUM(Fact_QualityAudits[AccessoryDefects])
		formatString: 0
		lineageTag: 01afec80-55fa-4480-80d3-0aa2e53e7be1

	measure 'Performance Defects' =
			
			SUM(Fact_QualityAudits[PerformanceDefects])
		formatString: 0
		lineageTag: 69ee313c-05a9-4f18-b627-c19a5553977b

	measure 'Functional Defects' =
			
			SUM(Fact_QualityAudits[FunctionalDefects])
		formatString: 0
		lineageTag: 9fd00520-91c7-484f-a13d-ea8cb8854905

	measure 'Appearance Defects' =
			
