model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Dim_Date","Dim_Auditor","Dim_Process","Fact_QualityAudits","Fact_OperationalAudits","Fact_OperationalTargets","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Dim_Date
ref table Dim_Auditor
ref table Dim_Process
ref table Fact_QualityAudits
ref table Fact_OperationalAudits
ref table Fact_OperationalTargets
ref table _Measures
ref table Dim_DefectType

ref cultureInfo en-US

